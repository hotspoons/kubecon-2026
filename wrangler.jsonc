{
  // The schedule app as a Cloudflare Worker: static assets only (the Vite build), no Worker code.
  // Every unknown path falls back to index.html, so a shared link (#d=…&s=…) opens the app.
  //
  // The custom domain: kubecon.siomporas.com in the siomporas.com zone. `custom_domain: true` makes
  // wrangler create the DNS record and the certificate on first deploy, as long as the API token can
  // edit the zone's DNS and Workers routes (README.md, "Deploy").
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kubecon-2026",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "kubecon.siomporas.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "observability": { "enabled": true }
}
