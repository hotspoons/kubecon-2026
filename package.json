{
  "name": "kubecon-2026",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A KubeCon + CloudNativeCon North America 2026 schedule browser that doesn't suck: a time × type grid, fuzzy search, interest filters per team member. Deployed as a Cloudflare Worker at kubecon.siomporas.com.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b",
    "fetch": "node scripts/fetch-schedule.mjs",
    "fetch:offline": "node scripts/fetch-schedule.mjs --offline",
    "tag": "node scripts/fetch-schedule.mjs --offline",
    "report": "node scripts/fetch-schedule.mjs --offline --report",
    "test": "node --test scripts/*.test.mjs",
    "worker": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "shot": "node scripts/shot.mjs"
  },
  "dependencies": {
    "@preact/signals": "^2.3.1",
    "fuse.js": "^7.1.0",
    "preact": "^10.27.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.2",
    "@types/node": "^24.13.2",
    "playwright": "^1.61.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "wrangler": "^4.50.0"
  }
}
